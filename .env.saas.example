# College Counselor SaaS production environment
#
# Copy to .env.saas, replace every REPLACE_* value, then restrict the file:
#   chmod 600 .env.saas
# Never commit .env.saas or paste it into tickets, chat, or Compose output.

# Public, same-origin HTTPS endpoint. PUBLIC_DOMAIN is a hostname only.
PUBLIC_DOMAIN=counselor.example.org
PUBLIC_ORIGIN=https://counselor.example.org
INVITE_BASE_URL=https://counselor.example.org

# Generate an independent value for every secret below:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY cannot be rotated without re-encrypting existing protected data.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SIM_INTERNAL_TOKEN=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET
STUDENT_STORAGE_SALT=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET
SAAS_EMAIL_PEPPER=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET
SAAS_PROVISIONING_TOKEN=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET

# Transactional email for organization and student invitations.
RESEND_API_KEY=REPLACE_WITH_RESEND_SERVER_API_KEY
EMAIL_FROM=College Counselor <no-reply@example.org>

# Server-side model/provider credentials.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_SERVER_API_KEY
SCORECARD_API_KEY=

# Operational policy. Keep high-privacy defaults for student accounts. Confirm
# the matching tenant policy and consent workflow in the operator runbook.
# Required technical baseline. Map it to an approved tenant-specific retention
# schedule and test cleanup/legal-hold behavior before accepting live data.
RETENTION_MODE=institutional
SAAS_GUARDIAN_CONSENT_REQUIRED=1
SAAS_POLICY_VERSION=2026.1
SAAS_INVITE_TTL_HOURS=72
# Sliding server-side inactivity lifetime. Keep aligned with the 15-minute
# student UI timer. Production accepts 5-120 minutes.
SAAS_SESSION_IDLE_MINUTES=15
SAAS_SESSION_ABSOLUTE_HOURS=168
SAAS_PASSWORD_RESET_TTL_MINUTES=30
# Persistent supporting-document limits for the shared single-writer volume.
SAAS_STUDENT_UPLOAD_QUOTA_MB=100
SAAS_TENANT_UPLOAD_QUOTA_MB=2048
# Reject new disk-backed uploads before the volume falls below this reserve.
SAAS_MIN_FREE_STORAGE_MB=512
CDS_DAILY_REFRESH=0
AUTO_REFRESH_CDS=0
ENABLE_DOMAIN_MONITOR=0

# Optional encrypted continuous SQLite backup. This is read only when the
# Compose "backup" profile is enabled. Use a bucket-scoped, write/list/read
# credential; do not use an account-wide key. Leave endpoint empty for AWS S3.
LITESTREAM_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY
LITESTREAM_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET_KEY
LITESTREAM_S3_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_PREFIX=college-counselor/production
# Optional health-gated dead-man URL; Litestream pings only after healthy syncs.
LITESTREAM_HEARTBEAT_URL=

# Required for encrypted Litestream replicas on AWS: a KMS key ARN or key ID.
# For non-AWS S3-compatible stores, use a provider-enforced server-side
# encryption policy and independently verify it before enabling the profile.
LITESTREAM_SSE_KMS_KEY_ID=REPLACE_WITH_AWS_KMS_KEY_ARN_OR_ID
