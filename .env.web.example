# Public hostname. Point this hostname's DNS records at the deployment host.
PUBLIC_DOMAIN=counselor.example.com
PUBLIC_ORIGIN=https://counselor.example.com

# Generate a different random value for every setting below. Do not reuse them.
# Example generator:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SIM_INTERNAL_TOKEN=REPLACE_WITH_A_RANDOM_64_HEX_TOKEN
STUDENT_STORAGE_SALT=REPLACE_WITH_A_DIFFERENT_RANDOM_64_HEX_TOKEN
REGISTRATION_ACCESS_CODE=REPLACE_WITH_A_DIFFERENT_RANDOM_64_HEX_TOKEN

# Required for AI coaching. Keep this server-side.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Optional. Without it, College Scorecard features use the packaged baseline.
SCORECARD_API_KEY=

RETENTION_MODE=consumer
CDS_DAILY_REFRESH=0
AUTO_REFRESH_CDS=0
ENABLE_DOMAIN_MONITOR=0
